{
  "name": "innovateflow-crm",
  "version": "1.0.0",
  "description": "InnovateFlow CRM",
  "author": "InnovateFlow",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "react-router dev",
    "build": "node scripts/check-env.mjs && react-router build",
    "start": "node scripts/serve.mjs",
    "typecheck": "react-router typegen && tsc",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  },
  "build": {
    "appId": "com.innovateflow.crm",
    "productName": "InnovateFlow CRM",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/client/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "asar": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
