{
  "name": "innovateflow-crm",
  "version": "1.0.0",
  "description": "InnovateFlow CRM",
  "author": "InnovateFlow",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node init && react-router build",
    "dev": "node init && react-router dev",
    "server": "node server/index.js",
    "start": "node init && react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "electron:dev": "electron .",
    "electron:build": "electron-builder --win"
  },
  "dependencies": {
    "@react-router/node": "^8.5.2",
    "@react-router/serve": "^8.5.2",
    "@supabase/supabase-js": "^2.119.2",
    "better-sqlite3": "^13.2.0",
    "cors": "^2.8.6",
    "dotenv": "^8.2.0",
    "express": "^5.3.0",
    "isbot": "^5.1.36",
    "node-fetch": "^3.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "sql.js": "^1.17.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  },
  "build": {
    "appId": "com.innovateflow.crm",
    "productName": "InnovateFlow CRM",
    "directories": {
      "output": "C:\\Users\\aleca\\AppData\\Local\\Temp\\kilo\\crm-dist"
    },
    "files": [
      "build/client/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "asar": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
